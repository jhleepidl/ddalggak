{
  "schema_version": "ddalggak.room_journey_scenario/v1",
  "id": "portfolio_evidence_panel",
  "title": "단일 모델 대비 독립 근거 패널",
  "description": "같은 Room 사실을 독립적으로 해석하고 충돌을 판정하는 다중 모델 구성이 더 신뢰할 수 있는 결정을 만드는지 비교한다.",
  "experiment": {
    "baseline": {
      "id": "solo",
      "title": "Strongest suitable single-model baseline",
      "collaboration_profile": "solo",
      "model_policy": "strongest_suitable_single",
      "input_kind": "normal"
    },
    "challengers": [
      {
        "id": "evidence_panel",
        "title": "Independent evidence panel",
        "collaboration_profile": "evidence_panel",
        "model_policy": "independent_evidence_models_then_adjudicate",
        "input_kind": "team_task"
      }
    ],
    "promotion_gate": {
      "min_quality_uplift": 0.08,
      "max_cost_ratio": 5.0,
      "max_latency_ratio": 4.0,
      "require_semantic_evidence": true,
      "require_cost_evidence": true,
      "require_exact_model_identity": true
    },
    "target_step_id": "request_decision",
    "required_context_step_ids": [
      "provide_evidence"
    ]
  },
  "steps": [
    {
      "id": "provide_evidence",
      "action": "send_message",
      "text": "의사결정에 쓸 사실은 세 가지야. A안은 초기 개발 2주, 월 운영비 180만원, 장애 시 수동 복구 40분이야. B안은 초기 개발 5주, 월 운영비 90만원, 자동 복구 8분이야. 우리는 6주 안에 출시해야 하고 첫해에는 장애 대응 인력이 한 명뿐이야. 이 사실들은 이번 판단에서 source of truth로 사용해줘.",
      "input_kind": "normal"
    },
    {
      "id": "request_decision",
      "action": "send_message",
      "text": "A안과 B안 중 무엇을 선택할지 결정 메모를 작성해줘. 사실, 해석, 불확실성을 분리하고 반대 의견이 가장 강한 지점도 다룬 뒤 최종 권고와 전환 조건을 제시해줘."
    }
  ],
  "assertions": [
    {
      "id": "evidence_turn_completed",
      "type": "step_ok",
      "step_id": "provide_evidence"
    },
    {
      "id": "decision_completed",
      "type": "step_ok",
      "step_id": "request_decision"
    },
    {
      "id": "solo_one_model",
      "type": "distinct_model_node_count",
      "arms": [
        "solo"
      ],
      "min": 1,
      "max": 1,
      "quality_metric": false,
      "step_id": "request_decision"
    },
    {
      "id": "panel_multiple_roles",
      "type": "successful_provider_role_count",
      "arms": [
        "evidence_panel"
      ],
      "min": 3,
      "quality_metric": false,
      "step_id": "request_decision"
    },
    {
      "id": "panel_distinct_models",
      "type": "distinct_model_node_count",
      "arms": [
        "evidence_panel"
      ],
      "min": 2,
      "quality_metric": false,
      "step_id": "request_decision"
    },
    {
      "id": "panel_required_model_roles",
      "type": "successful_model_roles_include",
      "arms": [
        "evidence_panel"
      ],
      "values": [
        "source_grounder",
        "verifier_critic",
        "delivery_synthesizer"
      ],
      "quality_metric": false,
      "step_id": "request_decision"
    },
    {
      "id": "panel_independent_lanes",
      "type": "distinct_lane_count",
      "arms": [
        "evidence_panel"
      ],
      "min": 2,
      "quality_metric": false,
      "step_id": "request_decision"
    },
    {
      "id": "solo_profile_applied",
      "type": "collaboration_profile_is",
      "arms": [
        "solo"
      ],
      "value": "solo",
      "quality_metric": false
    },
    {
      "id": "evidence_panel_profile_applied",
      "type": "collaboration_profile_is",
      "arms": [
        "evidence_panel"
      ],
      "value": "evidence_panel",
      "quality_metric": false
    },
    {
      "id": "provider_cli_has_no_failures",
      "type": "cli_failure_count",
      "min": 0,
      "max": 0,
      "quality_metric": false,
      "step_id": "request_decision"
    },
    {
      "id": "actual_cli_calls_match_model_role_map",
      "type": "model_role_map_alignment",
      "min": 1,
      "quality_metric": false,
      "step_id": "request_decision"
    }
  ],
  "semantic_rubric": [
    {
      "id": "fact_fidelity",
      "description": "제공된 수치와 제약을 바꾸거나 새 사실을 꾸며내지 않는다."
    },
    {
      "id": "fact_interpretation_separation",
      "description": "사실, 해석, 불확실성을 명확히 구분한다."
    },
    {
      "id": "counterargument",
      "description": "선택하지 않은 안의 가장 강한 반대 논거를 공정하게 다룬다."
    },
    {
      "id": "decision_quality",
      "description": "권고와 전환 조건이 인력·일정·복구 시간 제약에 연결된다."
    },
    {
      "id": "uncertainty_calibration",
      "description": "근거가 부족한 부분을 과신하지 않고 추가 확인이 필요한 조건을 명확히 한다."
    }
  ],
  "process_evidence_rubric": [
    {
      "id": "independent_verification_coverage",
      "description": "독립 evidence lane과 adjudication이 불일치·과신·근거 경계를 실제로 드러냈는지 별도 process evidence로 평가한다."
    }
  ]
}

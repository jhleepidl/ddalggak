# === Runs / Job Workspace ===
# Job workspace is deterministic:
#   <RUNS_DIR>/<jobId>/workspace
# Default RUNS_DIR is "runs" (relative to process cwd).
RUNS_DIR=runs

# === Memory Mode ===
# local: keep existing local file memory behavior
# goc: keep local md logs, but build prompts from GoC compiled context first (fallback to local)
MEMORY_MODE=local

# Agent registry (JSON path). If missing, built-in defaults are used.
AGENTS_REGISTRY_PATH=./agents.json

# === Telegram ===
TELEGRAM_BOT_TOKEN=123456:ABCDEF...

# Optional allowlists (comma-separated). Leave empty to accept all.
# Deprecated: chat allowlist is no longer enforced (kept only for backward compatibility).
# TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=

# In group/supergroup, handle plain text only when the bot is mentioned or message starts with "!".
TELEGRAM_REQUIRE_MENTION_IN_GROUP=false

# Concurrency
MAX_CONCURRENCY=1
MAX_PARALLEL_PER_RUN=3
INTERRUPT_DEBOUNCE_MS=500

# Auto-suggest next ChatGPT prompt after major steps (run/continue/action plan execution)
AUTO_SUGGEST_GPT_PROMPT=true
# /chat verbose logs (route/job/agent progress). false = final user-facing answer 중심
CHAT_VERBOSE=false
# Fine-tune reflection policy in `.orchestrator/settings.md` (or via `/memory` command)

# Telegram polling/runtime hardening
TELEGRAM_FORCE_IPV4=true
TELEGRAM_POLLING_INTERVAL_MS=1000
TELEGRAM_POLLING_TIMEOUT_SEC=15
TELEGRAM_SINGLE_INSTANCE_LOCK=true
# TELEGRAM_LOCK_FILE=/absolute/path/to/telegram_runner.lock

# Telegram upload/download limits
# Standard Bot API direct download limit is typically 20MB.
TELEGRAM_UPLOAD_MAX_MB=20
TELEGRAM_DOWNLOAD_MAX_BYTES=20971520
# Leave empty to allow all extensions.
TELEGRAM_UPLOAD_ALLOWED_EXTS=.txt,.md,.pdf,.csv,.json,.py,.ipynb,.jpg,.jpeg,.png,.mp4,.mp3,.ogg,.wav,.m4a

# Output auto-send behavior (outputs/ -> Telegram sendDocument)
OUTPUT_AUTO_SEND=true
OUTPUT_AUTO_SEND_MAX_FILES=4
# step: send after each agent step, run_end: send once at run completion
OUTPUT_AUTO_SEND_ON=step

# Codex CLI execution
CODEX_SANDBOX_MODE=workspace-write
CODEX_APPROVAL_POLICY=never

# Gemini CLI execution
# - default: safest baseline for headless use
# - plan: requires ~/.gemini/settings.json with {"experimental":{"plan":true}}
GEMINI_APPROVAL_MODE=default
MAX_CONCURRENT_GEMINI=1
GEMINI_MIN_INTERVAL_MS=2000
GEMINI_RETRY_TIMEBOX_MS=180000
GEMINI_MAX_RETRIES=8
GEMINI_BACKOFF_BASE_MS=1000
GEMINI_BACKOFF_MAX_MS=30000
GEMINI_CAPACITY_COOLDOWN_MS=60000
# Comma-separated fallback candidates. Keep "auto" to let CLI routing pick available models.
GEMINI_MODEL_FALLBACKS=auto
# Optional workspace-level hard pin. Leave empty or set "auto" to avoid forced pinning.
# GEMINI_WORKSPACE_MODEL=
GEMINI_SETTINGS_OVERWRITE=merge
# GEMINI_DEBUG_LOG=gemini_debug.log

# === GoC Context OS (used when MEMORY_MODE=goc) ===
# IMPORTANT: backend API origin (NOT Vite frontend URL)
# ex) http://127.0.0.1:8000
GOC_API_BASE=http://127.0.0.1:8000
# UI origin (frontend)
# ex) http://127.0.0.1:5173
GOC_UI_BASE=http://127.0.0.1:5173
# Optional public UI origin for external browser/Telegram buttons (prefer HTTPS)
# ex) https://goc.example.com
# GOC_UI_PUBLIC_BASE=
GOC_SERVICE_KEY=
# UI 토큰(쓰기 권한 포함) TTL. 짧게 유지 권장.
GOC_UI_TOKEN_TTL_SEC=21600
# Browser fallback link token TTL (seconds). Keep this short.
GOC_UI_BROWSER_TOKEN_TTL_SEC=3600
# telegram_auth(default): issue link without #token (Telegram SSO)
# bearer_token: legacy behavior, append #token=...
GOC_UI_LINK_MODE=telegram_auth
GOC_AUTO_ACTIVATE_PROGRESS=false
GOC_JOB_THREAD_TITLE_PREFIX=job:

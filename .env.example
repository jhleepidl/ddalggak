# DdalGgak / AI Rooms runtime configuration
# Copy to .env and fill secrets locally. Real .env files are excluded from source bundles.

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_REQUIRE_MENTION_IN_GROUP=false
TZ=Asia/Seoul
DEFAULT_USER_LOCALE=ko
RUNS_DIR=runs

# Simple runtime routing
DDALGGAK_RUNTIME_PRESET=local_fast
DDALGGAK_FAST_PROVIDER=antigravity
DDALGGAK_SEARCH_PROVIDER=antigravity
DDALGGAK_WORK_PROVIDER=codex
DDALGGAK_CONTEXT_BUDGET=medium

# Latency policy
DDALGGAK_FAST_TIMEOUT_MS=25000
DDALGGAK_SEARCH_TIMEOUT_MS=20000
DDALGGAK_SEARCH_FALLBACK_TO_WORKBENCH=false
DDALGGAK_SEARCH_FALLBACK_NOTICE=true

# Optional explicit model labels. Leave blank unless you know the executable model.
DDALGGAK_FAST_MODEL=
DDALGGAK_SEARCH_MODEL=
DDALGGAK_WORK_MODEL=
CODEX_MODEL=
CODEX_ASSIST_MODEL=

# Local/OpenAI-compatible provider, used only when FAST/SEARCH provider is openai_compatible.
DDALGGAK_LOCAL_BASE_URL=
DDALGGAK_LOCAL_API_KEY=
DDALGGAK_LOCAL_MODEL=

# Codex CLI policy for workbench/code paths.
CODEX_SANDBOX_MODE=workspace-write
CODEX_APPROVAL_POLICY=never

# Claude Code CLI provider (set FAST/SEARCH/WORK provider to claude to use it).
# Runs `claude -p --output-format json` headless and records measured tokens/cost/latency
# into per-agent telemetry. Extra flags (e.g. --dangerously-skip-permissions for coding
# rooms) go in CLAUDE_CLI_ARGS.
CLAUDE_CLI_COMMAND=claude
CLAUDE_CLI_ARGS=
CLAUDE_CLI_MODEL=
# Comma-separated exact model IDs to test in addition to the stable aliases below.
CLAUDE_MODEL_CANDIDATES=
CLAUDE_MODEL_DISCOVERY_INCLUDE_ALIASES=true
CLAUDE_CLI_TIMEOUT_MS=300000


# Provider CLI commands. Model discovery runs only in the background while the runtime is idle.
CODEX_CLI_COMMAND=codex
# Optional fallback when `codex debug models` cannot read the account catalog.
CODEX_MODEL_CANDIDATES=

ANTIGRAVITY_CLI_COMMAND=agy
ANTIGRAVITY_MODEL_ARG=--model
# Antigravity versions do not expose one stable machine-readable model-list command.
# Add exact model IDs separated by commas. When blank, bench-all tests provider default.
ANTIGRAVITY_MODEL_CANDIDATES=

# Cached model discovery. Normal Telegram requests only read the cached catalog; they never run /model discovery.
MODEL_CATALOG_REFRESH_ENABLED=true
MODEL_CATALOG_REFRESH_INTERVAL_MS=86400000
MODEL_CATALOG_REFRESH_CHECK_INTERVAL_MS=300000
MODEL_CATALOG_REFRESH_STARTUP_DELAY_MS=30000
MODEL_CATALOG_REFRESH_IDLE_MIN_MS=60000
MODEL_CATALOG_REFRESH_CLI_VERSION_CHECK_INTERVAL_MS=3600000
MODEL_CATALOG_REFRESH_ON_CLI_VERSION_CHANGE=true
CODEX_CLI_MODEL_DISCOVERY_ENABLED=true
CLAUDE_CLI_MODEL_DISCOVERY_ENABLED=true
ANTIGRAVITY_CLI_MODEL_DISCOVERY_ENABLED=true
# If named candidates cannot be discovered, keep an @default benchmark selector instead of an empty catalog.
MODEL_DISCOVERY_INCLUDE_PROVIDER_DEFAULT=true
MODEL_BENCHMARK_MIN_RUNS=3

# Legacy Gemini-style agent packages can be migrated to the work provider.
DDALGGAK_GEMINI_REPLACEMENT_PROVIDER=codex

# GoC integration. Prefer late sync so chat answers are not blocked by GoC route issues.
GOC_API_BASE=http://127.0.0.1:8703
# Optional GoC -> ddalggak desired-state command polling. Disabled by default.
# Set true to enable GoC Edit Room direct apply; the worker accepts only the bounded Room continuity command allowlist.
GOC_RUNTIME_COMMAND_POLL_ENABLED=false
GOC_RUNTIME_COMMAND_POLL_INTERVAL_MS=1500
GOC_RUNTIME_COMMAND_POLL_MAX_INTERVAL_MS=5000
GOC_RUNTIME_COMMAND_POLL_ERROR_INTERVAL_MS=30000
GOC_RUNTIME_COMMAND_POLL_LIMIT=20
# Local-first runtime event delivery is automatically enabled when GoC is active.
GOC_RUN_EVENT_OUTBOX_ENABLED=true
GOC_RUN_EVENT_BATCH_SIZE=50
GOC_SERVICE_KEY=
GOC_SYNC_MODE=late
GOC_LATE_SYNC_ENABLED=true
GOC_ROUTE_CIRCUIT_BREAKER_THRESHOLD=2
GOC_ROUTE_CIRCUIT_BREAKER_COOLDOWN_MS=300000

# Tracing while developing. Disable prompt/output persistence for stricter production privacy.
LLM_TRACE_ENABLED=true
LLM_TRACE_SAVE_PROMPTS=true
LLM_TRACE_SAVE_OUTPUTS=true
LLM_TRACE_REDACT_SECRETS=true
LLM_TRACE_UNSCOPED=false
CHAT_SHOW_MODEL_BADGE=true

# Inspect your effective settings in Telegram:
# /config
# /config doctor

# DdalGgak runtime environment sample
# Keep this file small: most advanced knobs have safe code defaults.
# Copy to .env and fill only the values you actually use.

# === Workspace / memory ===
RUNS_DIR=runs
# local = fastest default. goc = use GoC compiled context when available.
MEMORY_MODE=local
# Start each chat/run with one compact core memory; split later only under pressure.
MEMORY_SEED_MODE=adaptive_compact

# === Telegram ===
TELEGRAM_BOT_TOKEN=
# Optional comma-separated user allowlist. Leave empty to accept all users.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_REQUIRE_MENTION_IN_GROUP=false
MAX_CONCURRENCY=1
MAX_PARALLEL_PER_RUN=3
CHAT_VERBOSE=false

# === Codex CLI ===
CODEX_SANDBOX_MODE=workspace-write
# Use never for non-interactive fail-closed execution.
# For trusted local workspaces only, set CODEX_APPROVAL_POLICY=workspace-auto to allow workspace-write without interactive prompts while refusing cwd/add-dir outside the workspace.
CODEX_APPROVAL_POLICY=never

# === Runtime providers ===
# Gemini CLI is deprecated/disabled by default. Do not use the legacy `gemini` binary.
# If old room/GoC agent records still say provider=gemini, DdalGgak migrates them at runtime.
DDALGGAK_ALLOW_GEMINI_CLI=0
# Recommended: use codex until Antigravity CLI command/args are verified on this server.
# Set to antigravity only after ANTIGRAVITY_CLI_COMMAND / ANTIGRAVITY_CLI_ARGS work non-interactively.
DDALGGAK_GEMINI_REPLACEMENT_PROVIDER=codex
ROOM_ASK_PROVIDER=codex
ROOM_AGENT_PROVIDER=codex
CHAT_SUPERVISOR_PROVIDER=codex
TEAM_PLANNER_PROVIDER=codex

# Optional Antigravity bridge. Exact CLI flags may differ by installed Antigravity version; configure after manual probe.
# DDALGGAK_GEMINI_REPLACEMENT_PROVIDER=antigravity
# ROOM_ASK_PROVIDER=antigravity
# ROOM_AGENT_PROVIDER=antigravity
# CHAT_SUPERVISOR_PROVIDER=antigravity
# TEAM_PLANNER_PROVIDER=antigravity
# ANTIGRAVITY_CLI_COMMAND=antigravity
# ANTIGRAVITY_CLI_ARGS=
# ANTIGRAVITY_MODEL=auto
# ANTIGRAVITY_TIMEOUT_MS=240000


# === Account / provider ownership ===
# deployment_owner = server operator owns configured provider credentials.
# per_user_isolated is experimental; requires per-user HOME/container or secret-store isolation.
PROVIDER_ACCOUNT_MODE=deployment_owner

# provider=chatgpt now executes through Codex CLI by default instead of Telegram copy/paste.
CHATGPT_PROVIDER_BRIDGE=codex
CHATGPT_CODEX_SANDBOX_MODE=read-only
CHATGPT_CODEX_APPROVAL_POLICY=never
# Legacy copy/paste fallback is off by default. Enable only for debugging.
CHATGPT_MANUAL_FALLBACK_ENABLED=false
AUTO_SUGGEST_GPT_PROMPT=false

# === Provider failover ===
# Provider failover remains available for legacy traces, but Gemini CLI is not a primary route.
PROVIDER_FAILOVER_ENABLED=true
GEMINI_CAPACITY_FAILOVER_ENABLED=false
GEMINI_CAPACITY_FAILOVER_PROVIDER=codex
CODEX_ASSIST_SANDBOX_MODE=read-only
CODEX_ASSIST_APPROVAL_POLICY=never
# Router should not use Gemini CLI. CHAT_SUPERVISOR_PROVIDER is set in Runtime providers above.
CHAT_SUPERVISOR_GEMINI_TOOL_LEAK_COOLDOWN_MS=600000
CHAT_SUPERVISOR_CODEX_SANDBOX_MODE=read-only
CHAT_SUPERVISOR_CODEX_APPROVAL_POLICY=never

# Add a tiny footer like "↳ model: answer gemini/... · agent gemini/..." to chat replies.
CHAT_SHOW_MODEL_BADGE=true
CHAT_MODEL_BADGE_MAX_PARTS=3

# === GoC observation / control plane ===
# Used when MEMORY_MODE=goc or when generating GoC links.
GOC_API_BASE=http://127.0.0.1:8000
GOC_UI_BASE=http://127.0.0.1:5173
GOC_SERVICE_KEY=
# Queue GoC updates out of the first-turn critical path.
GOC_SYNC_MODE=late
# Bootstrap memory stays local; meaningful runtime events can sync later.
GOC_SYNC_BOOTSTRAP_MEMORY=0
GOC_UI_LINK_MODE=telegram_auth

# === Optional local/API model mesh ===
# Prefer config/model_nodes.example.json for multiple nodes.
# Native Ollama base URLs such as http://localhost:11434 are supported; /v1 OpenAI-compatible URLs still work.
# DDALGGAK_MODEL_NODES_CONFIG=./config/model_nodes.json
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:12b
# OLLAMA_COST_TIER=free
# OLLAMA_LATENCY_TIER=medium
# OLLAMA_QUALITY_TIER=standard
# For a remote Ollama box you control, use http://host:11434 and keep trusted context explicit.
# OLLAMA_BASE_URL=http://192.168.1.50:11434
# OLLAMA_MODEL=qwen2.5-coder:14b
# OLLAMA_PRIVACY_TIER=trusted_private
# OLLAMA_DATA_BOUNDARY=user_controlled_remote
# OLLAMA_TRUSTED_CONTEXT=true
# LOCAL_MODEL_PREFER_FOR=private_context,review,draft
# MODEL_NODE_HEALTH_TIMEOUT_MS=4000
# MODEL_NODE_DISCOVERY_TIMEOUT_MS=5000
# MODEL_CATALOG_REFRESH_ENABLED=true
# MODEL_CATALOG_REFRESH_INTERVAL_MS=86400000
# MODEL_CATALOG_REFRESH_STARTUP_DELAY_MS=2500
# MODEL_NODES_DISCOVERED_CONFIG=./config/model_nodes.discovered.json
# CODEX_CLI_MODEL_DISCOVERY_ENABLED=true
# GEMINI_CLI_MODEL_DISCOVERY_ENABLED=false
# CLI_MODEL_DISCOVERY_TIMEOUT_MS=12000

# === Optional debugging ===
LLM_TRACE_ENABLED=false
LLM_TRACE_REDACT_SECRETS=true
# GEMINI_DEBUG_LOG=gemini_debug.log  # legacy only; Gemini CLI is disabled by default

# === Agent package sharing ===
AGENT_PACKAGE_REGISTRY_PATH=config/agent_packages.json

# === Skill/rule evolution ===
# Stores learned/evaluated reuse scores for skills and runtime rules.
SKILL_RULE_PERFORMANCE_PATH=config/skill_rule_performance.json
SEMANTIC_BOARD_DIR=config/semantic_board
# External skill/rule imports are local-path or pasted-JSON only by default.
# Download/review remote packages manually before importing them.

# === Primitive context substrate / MVCC ===
CONTEXT_SUBSTRATE_DIR=config/context_substrate
CONTEXT_SUBSTRATE_COMMIT_MODE=mvcc_append_only
CONTEXT_PROJECTION_CACHE=true

# Team Compatibility Prior advisory scorer integration.
# off     : do not build/scrore skeleton advisory rows.
# shadow  : score candidates and expose results in traces/UI, but do not change selection.
# rerank  : allow learned advisory score to re-rank candidates after deterministic gates.
TEAM_COMPAT_ADVISORY_MODE=shadow
# Command receives a JSON advisory request on stdin and should print either JSON
# {"labels":{"Y_UTIL":"good",...},"confidence":0.8} or canonical label text.
# TEAM_COMPAT_SCORER_CMD=python /path/to/scorer_cli.py --adapter /path/to/adapter
TEAM_COMPAT_SCORER_TIMEOUT_MS=45000
# Local deterministic mock for smoke tests only.
TEAM_COMPAT_SCORER_MOCK=0

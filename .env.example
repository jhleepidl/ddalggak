# === Runs / Job Workspace ===
# Job workspace is deterministic:
#   <RUNS_DIR>/<jobId>/workspace
# Default RUNS_DIR is "runs" (relative to process cwd).
RUNS_DIR=runs

# === Memory Mode ===
# local: keep existing local file memory behavior
# goc: keep local md logs, but build prompts from GoC compiled context first (fallback to local)
MEMORY_MODE=local

# Agent registry (JSON path). If missing, built-in defaults are used.
AGENTS_REGISTRY_PATH=./agents.json

# === Telegram ===
TELEGRAM_BOT_TOKEN=123456:ABCDEF...

# Optional allowlists (comma-separated). Leave empty to accept all.
# Deprecated: chat allowlist is no longer enforced (kept only for backward compatibility).
# TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=

# In group/supergroup, handle plain text only when the bot is mentioned or message starts with "!".
TELEGRAM_REQUIRE_MENTION_IN_GROUP=false

# Concurrency
MAX_CONCURRENCY=1
MAX_PARALLEL_PER_RUN=3
INTERRUPT_DEBOUNCE_MS=500

# Auto-suggest next ChatGPT prompt after major steps (run/continue/action plan execution)
AUTO_SUGGEST_GPT_PROMPT=true
# /chat verbose logs (route/job/agent progress). false = final user-facing answer 중심
CHAT_VERBOSE=false
# Fine-tune reflection policy in `.orchestrator/settings.md` (or via `/memory` command)

# Telegram polling/runtime hardening
TELEGRAM_FORCE_IPV4=true
TELEGRAM_POLLING_INTERVAL_MS=1000
TELEGRAM_POLLING_TIMEOUT_SEC=15
TELEGRAM_SINGLE_INSTANCE_LOCK=true
# TELEGRAM_LOCK_FILE=/absolute/path/to/telegram_runner.lock

# Telegram upload/download limits
# Standard Bot API direct download limit is typically 20MB.
TELEGRAM_UPLOAD_MAX_MB=20
TELEGRAM_DOWNLOAD_MAX_BYTES=20971520
# Leave empty to allow all extensions.
TELEGRAM_UPLOAD_ALLOWED_EXTS=.txt,.md,.pdf,.csv,.json,.py,.ipynb,.jpg,.jpeg,.png,.mp4,.mp3,.ogg,.wav,.m4a

# Artifact delivery
# 최종 파일은 workspace 원본 경로에 유지되며, Telegram 첨부는 /send <번호|path> 로만 전송합니다.

# Codex CLI execution
CODEX_SANDBOX_MODE=workspace-write
CODEX_APPROVAL_POLICY=never

# Gemini CLI execution
# - default: safest baseline for headless use
# - plan: requires ~/.gemini/settings.json with {"experimental":{"plan":true}}
GEMINI_APPROVAL_MODE=default
MAX_CONCURRENT_GEMINI=1
GEMINI_MIN_INTERVAL_MS=2000
GEMINI_RETRY_TIMEBOX_MS=180000
GEMINI_MAX_RETRIES=8
GEMINI_BACKOFF_BASE_MS=1000
GEMINI_BACKOFF_MAX_MS=30000
GEMINI_CAPACITY_COOLDOWN_MS=60000
# Comma-separated fallback candidates. Keep "auto" to let CLI routing pick available models.
GEMINI_MODEL_FALLBACKS=auto
# Optional workspace-level hard pin. Leave empty or set "auto" to avoid forced pinning.
# GEMINI_WORKSPACE_MODEL=
GEMINI_SETTINGS_OVERWRITE=merge
# GEMINI_DEBUG_LOG=gemini_debug.log


# === LLM raw trace for manual debugging ===
# Keep this ON when you want to share traces with ChatGPT for manual code improvement.
# Raw traces stay on the server; GoC should receive summaries only.
LLM_TRACE_ENABLED=true
LLM_TRACE_SAVE_PROMPTS=true
LLM_TRACE_SAVE_OUTPUTS=true
LLM_TRACE_SAVE_STDERR=true
LLM_TRACE_REDACT_SECRETS=true
LLM_TRACE_MAX_PROMPT_CHARS=300000
LLM_TRACE_MAX_OUTPUT_CHARS=300000
LLM_TRACE_MAX_STDERR_CHARS=150000
# Default false is safer. If true, calls without a jobId are saved under RUNS_DIR/_unscoped/llm_traces.
LLM_TRACE_UNSCOPED=false
# Optional explicit trace directory. Prefer leaving empty unless you are doing a one-off canary.
# LLM_TRACE_DIR=/absolute/path/to/llm_traces

# === GoC Context OS (used when MEMORY_MODE=goc) ===
# IMPORTANT: backend API origin (NOT Vite frontend URL)
# ex) http://127.0.0.1:8000
GOC_API_BASE=http://127.0.0.1:8000
# UI origin (frontend)
# ex) http://127.0.0.1:5173
GOC_UI_BASE=http://127.0.0.1:5173
# Optional public UI origin for external browser/Telegram buttons (prefer HTTPS)
# ex) https://goc.example.com
# GOC_UI_PUBLIC_BASE=
GOC_SERVICE_KEY=
# UI 토큰(쓰기 권한 포함) TTL. 짧게 유지 권장.
GOC_UI_TOKEN_TTL_SEC=21600
# Browser fallback link token TTL (seconds). Keep this short.
GOC_UI_BROWSER_TOKEN_TTL_SEC=3600
# telegram_auth(default): issue link without #token (Telegram SSO)
# bearer_token: legacy behavior, append #token=...
GOC_UI_LINK_MODE=telegram_auth
GOC_AUTO_ACTIVATE_PROGRESS=false
GOC_JOB_THREAD_TITLE_PREFIX=job:

# === Codex model policy for self-improvement patching ===
# Recommended default: balanced. It uses gpt-5.5 for normal/complex patches,
# gpt-5.4-mini for documentation/wording-only patches, and gpt-5.4 when you
# explicitly run Codex with API-key auth.
# Options: balanced, quality, economy, api_key, fixed, cli-default
SELF_IMPROVE_CODEX_MODEL_POLICY=balanced
# Use chatgpt when Codex CLI is logged in with ChatGPT. Use api_key in CI/shared
# API-key environments because gpt-5.5 may not be available there. auto tries
# the frontier default and falls back on model availability errors.
SELF_IMPROVE_CODEX_AUTH_MODE=auto
SELF_IMPROVE_CODEX_FRONTIER_MODEL=gpt-5.5
SELF_IMPROVE_CODEX_API_MODEL=gpt-5.4
SELF_IMPROVE_CODEX_MINI_MODEL=gpt-5.4-mini
SELF_IMPROVE_CODEX_FALLBACK_MODEL=gpt-5.4
SELF_IMPROVE_CODEX_FALLBACK_ON_MODEL_ERROR=true
# Optional overrides. Leave unset for policy-based routing.
# SELF_IMPROVE_CODEX_MODEL=gpt-5.5
# SELF_IMPROVE_CODEX_TASK_TIER=auto  # auto|light|standard|complex|heavy

# === Self-improvement runtime (Telegram -> forge tests/canary/promote) ===
# Point these to forge workspaces or worktrees. Example:
# SELF_IMPROVE_DDALGGAK_WORKSPACE=/srv/ddalggak-forge
# SELF_IMPROVE_GOC_WORKSPACE=/srv/goc-forge
# Commands are split with ';;' when multiple steps are needed.
# SELF_IMPROVE_DDALGGAK_TEST_CMD=node --check src/goc_client.js;;node --test test/goc_raw_history_sync.test.js test/goc_board_candidate_client.test.js
# SELF_IMPROVE_GOC_TEST_CMD=python -m py_compile backend/app/main.py backend/app/routers/boards.py backend/app/routers/improvement_jobs.py;;cd backend && python -m unittest tests.test_board_history_logic tests.test_improvement_job_logic
# SELF_IMPROVE_DDALGGAK_CANARY_CMD=
# SELF_IMPROVE_GOC_CANARY_CMD=python -m py_compile backend/app/services/improvement_jobs.py
# Optional restart/promote hooks for stable runtime rollout.
# SELF_IMPROVE_DDALGGAK_RESTART_CMD=screen -S ddalggak-stable -X stuff $'\003node telegram_runner.js\n'
# SELF_IMPROVE_GOC_RESTART_CMD=screen -S goc-backend-stable -X stuff $'\003uvicorn app.main:app --reload\n'

# Agency-first / trace-first operating mode
# Keep the core product focused on visible agent collaboration. Use self-improve as a trace/test/review aid until canary coverage is mature.
LLM_TRACE_ENABLED=true
LLM_TRACE_SAVE_PROMPTS=true
LLM_TRACE_SAVE_OUTPUTS=true
LLM_TRACE_SAVE_STDERR=true
LLM_TRACE_REDACT_SECRETS=true
LLM_TRACE_UNSCOPED=false
SELF_IMPROVE_DDALGGAK_AUTO_PROMOTE=false
SELF_IMPROVE_GOC_AUTO_PROMOTE=false
# Leave PATCH_CMD empty during trace-first stabilization; enable only for bounded experiments.
# SELF_IMPROVE_DDALGGAK_PATCH_CMD=
# SELF_IMPROVE_GOC_PATCH_CMD=

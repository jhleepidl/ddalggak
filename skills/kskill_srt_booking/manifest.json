      "delivery": "job_env",
      "scope": "skill:kskill_srt_booking"
    },
    {
      "key": "KSKILL_SRT_PASSWORD",
      "required": true,
      "provider": "srt",
      "delivery": "job_env",
      "scope": "skill:kskill_srt_booking"
    }
  ],
  "install_recipe": {
    "python_packages": [
      "SRTrain"
    ],
    "setup_steps": [
      "Install k-skill and SRTrain dependencies.",
      "Bind KSKILL_SRT_ID and KSKILL_SRT_PASSWORD before execution."
    ],
    "verify_commands": [
      "python -m srt_booking --help"
    ]
  },
  "source_package": {

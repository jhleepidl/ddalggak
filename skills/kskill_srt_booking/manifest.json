  "description": "Use k-skill to search/book/cancel SRT reservations through a Python CLI style adapter.",
  "category": "travel",
  "kind": "tool",
  "capability_tags": [
    "k-skill",
    "srt",
    "booking",
    "travel"
  ],
  "trigger_terms": [
    "srt",
    "train booking",
    "기차 예매",
    "srt 예약"
  ],

# ============================================================
# Runs / locale
# ============================================================

RUNS_DIR=runs
TZ=Asia/Seoul
DEFAULT_USER_LOCALE=ko


# ============================================================
# Telegram
# ============================================================

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_REQUIRE_MENTION_IN_GROUP=false


# ============================================================
# Runtime routing — hybrid dogfood
# ============================================================

DDALGGAK_RUNTIME_PRESET=local_fast

# 짧은 질문, 빠른 대화, Room Concierge 직접 응답
DDALGGAK_FAST_PROVIDER=antigravity

# 조사 및 검색형 요청
DDALGGAK_SEARCH_PROVIDER=antigravity

# 구현, 파일 수정, 테스트, 장기 작업
DDALGGAK_WORK_PROVIDER=codex

DDALGGAK_CONTEXT_BUDGET=medium

# 정확한 CLI model ID를 고정할 때만 입력.
# 비워두면 역할별 provider 기본 모델을 사용.
DDALGGAK_FAST_MODEL=
DDALGGAK_SEARCH_MODEL=
DDALGGAK_WORK_MODEL=


# ============================================================
# Model-role policy — system source of truth
# ============================================================

# generated team/planner output에는 아래 역할 정책을 강제하고,
# 사용자가 명시적으로 저장한 Room/team override는 별도 governance 경로로 관리.
TEAM_ROLE_PROVIDER_POLICY_MODE=enforce_generated

# Supervisor, planner, operator
DDALGGAK_MODEL_ROLE_CONCIERGE_ROUTER_PROVIDER=antigravity
DDALGGAK_MODEL_ROLE_CONCIERGE_ROUTER_MODEL=

# Research, retrieval, source grounding
DDALGGAK_MODEL_ROLE_SOURCE_GROUNDER_PROVIDER=antigravity
DDALGGAK_MODEL_ROLE_SOURCE_GROUNDER_MODEL=

# Implementation, revision, test/fix
DDALGGAK_MODEL_ROLE_CODE_EXECUTOR_PROVIDER=codex
DDALGGAK_MODEL_ROLE_CODE_EXECUTOR_MODEL=

# Independent review, critique, adjudication
DDALGGAK_MODEL_ROLE_VERIFIER_CRITIC_PROVIDER=antigravity
DDALGGAK_MODEL_ROLE_VERIFIER_CRITIC_MODEL=

# Idle compaction and memory structuring
DDALGGAK_MODEL_ROLE_IDLE_STRUCTURER_PROVIDER=antigravity
DDALGGAK_MODEL_ROLE_IDLE_STRUCTURER_MODEL=

# Progress summary, final synthesis and delivery
DDALGGAK_MODEL_ROLE_DELIVERY_SYNTHESIZER_PROVIDER=antigravity
DDALGGAK_MODEL_ROLE_DELIVERY_SYNTHESIZER_MODEL=


# ============================================================
# Latency policy
# ============================================================

DDALGGAK_FAST_TIMEOUT_MS=60000
DDALGGAK_SEARCH_TIMEOUT_MS=90000

# 빠른 search가 실패했다고 무거운 workbench를 자동 실행하지 않음.
DDALGGAK_SEARCH_FALLBACK_TO_WORKBENCH=false
DDALGGAK_SEARCH_FALLBACK_NOTICE=true


# ============================================================
# Memory / Room continuity
# ============================================================

MEMORY_MODE=goc
MEMORY_SEED_MODE=adaptive_compact


# ============================================================
# Loop execution UX / memory lifecycle
# ============================================================

# quiet | standard | debug
DDALGGAK_LOOP_DEFAULT_VISIBILITY=quiet

IDLE_MEMORY_MAINTENANCE_ENABLED=true
IDLE_LOOP_MEMORY_MAINTENANCE_LIMIT=100
IDLE_MEMORY_MAINTENANCE_MIN_INTERVAL_MS=300000
IDLE_MEMORY_COMPACTION_STRESS_THRESHOLD=2.4


# ============================================================
# Concurrency
# ============================================================

MAX_CONCURRENCY=1
MAX_PARALLEL_PER_RUN=3
CHAT_VERBOSE=false


# ============================================================
# Antigravity CLI — routing/research/review/synthesis
# ============================================================

ANTIGRAVITY_CLI_COMMAND=agy
ANTIGRAVITY_CLI_ARGS=
ANTIGRAVITY_MODEL_ARG=--model
ANTIGRAVITY_MODEL_DISCOVERY_ARGS=models

# `agy models`가 반환한 정확한 전체 selector를 입력.
ANTIGRAVITY_MODEL=
ANTIGRAVITY_TIMEOUT_MS=300000


# ============================================================
# Codex CLI / Workbench — implementation/revision/tests
# ============================================================

CODEX_CLI_COMMAND=codex
CODEX_SANDBOX_MODE=workspace-write
CODEX_APPROVAL_POLICY=never

CODEX_MODEL=
CODEX_ASSIST_MODEL=

# Assistant/fallback 경로는 read-only 유지.
CODEX_ASSIST_SANDBOX_MODE=read-only
CODEX_ASSIST_APPROVAL_POLICY=never


# ============================================================
# Claude Code CLI — currently unavailable, kept inactive
# ============================================================

CLAUDE_CLI_COMMAND=claude
CLAUDE_CLI_ARGS=
CLAUDE_CLI_MODEL=
CLAUDE_CLI_TIMEOUT_MS=300000


# ============================================================
# Supervisor / team topology planner
# ============================================================

CHAT_SUPERVISOR_PROVIDER=antigravity
CHAT_SUPERVISOR_ANTIGRAVITY_TIMEOUT_MS=60000

TEAM_PLANNER_MODE=antigravity
TEAM_PLANNER_PROVIDER=antigravity
TEAM_CREATE_PLANNER_PROVIDER=antigravity
TEAM_REFINE_PLANNER_PROVIDER=antigravity

# 비워두면 ANTIGRAVITY_MODEL을 사용.
TEAM_ANTIGRAVITY_PLANNER_MODEL=
TEAM_CREATE_ANTIGRAVITY_PLANNER_MODEL=
TEAM_REFINE_ANTIGRAVITY_PLANNER_MODEL=
TEAM_CREATE_PLANNER_TIMEOUT_MS=60000
TEAM_REFINE_PLANNER_TIMEOUT_MS=60000


# ============================================================
# Idle model discovery
# ============================================================

MODEL_CATALOG_REFRESH_ENABLED=true
MODEL_CATALOG_REFRESH_INTERVAL_MS=86400000
MODEL_CATALOG_REFRESH_CHECK_INTERVAL_MS=300000
MODEL_CATALOG_REFRESH_STARTUP_DELAY_MS=30000
MODEL_CATALOG_REFRESH_IDLE_MIN_MS=60000
MODEL_CATALOG_REFRESH_CLI_VERSION_CHECK_INTERVAL_MS=3600000
MODEL_CATALOG_REFRESH_ON_CLI_VERSION_CHANGE=true

CODEX_CLI_MODEL_DISCOVERY_ENABLED=true
CLAUDE_CLI_MODEL_DISCOVERY_ENABLED=false
ANTIGRAVITY_CLI_MODEL_DISCOVERY_ENABLED=true

MODEL_BENCHMARK_MIN_RUNS=3


# ============================================================
# GoC Context OS
# ============================================================

GOC_API_BASE=http://147.47.236.50:35703
GOC_UI_BASE=http://147.47.236.50:35703/
GOC_SERVICE_KEY=

GOC_RUNTIME_COMMAND_POLL_ENABLED=true
GOC_RUNTIME_COMMAND_POLL_INTERVAL_MS=1500
GOC_RUNTIME_COMMAND_POLL_MAX_INTERVAL_MS=5000
GOC_RUNTIME_COMMAND_POLL_ERROR_INTERVAL_MS=30000
GOC_RUNTIME_COMMAND_POLL_LIMIT=20

GOC_RUN_EVENT_OUTBOX_ENABLED=true
GOC_RUN_EVENT_BATCH_SIZE=50

GOC_SYNC_MODE=late
GOC_LATE_SYNC_ENABLED=true
GOC_SYNC_BOOTSTRAP_MEMORY=0
GOC_UI_LINK_MODE=telegram_auth

GOC_ROUTE_CIRCUIT_BREAKER_THRESHOLD=2
GOC_ROUTE_CIRCUIT_BREAKER_COOLDOWN_MS=300000


# ============================================================
# LLM traces
# ============================================================

LLM_TRACE_ENABLED=true
LLM_TRACE_SAVE_PROMPTS=true
LLM_TRACE_SAVE_OUTPUTS=true
LLM_TRACE_REDACT_SECRETS=true
LLM_TRACE_UNSCOPED=false


# ============================================================
# Telegram reply footer
# ============================================================

CHAT_SHOW_MODEL_BADGE=true
CHAT_MODEL_BADGE_MAX_PARTS=3


# ============================================================
# Model discovery candidates
# ============================================================

CODEX_MODEL_CANDIDATES=

CLAUDE_MODEL_DISCOVERY_INCLUDE_ALIASES=false
CLAUDE_MODEL_CANDIDATES=

# `agy models`의 정확한 selector를 쉼표로 구분.
ANTIGRAVITY_MODEL_CANDIDATES=

MODEL_DISCOVERY_INCLUDE_PROVIDER_DEFAULT=true
